<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<LibDaveRuntimeLinking>true</LibDaveRuntimeLinking>
	</PropertyGroup>

	<PropertyGroup>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<StartupObject></StartupObject>
		<ApplicationIcon />
		<Win32Resource />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Commands" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Core" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Dave" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Interactions" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Rest" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Webhook" Version="3.20.2" />
		<PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
		<PackageReference Include="DotNetEnv" Version="3.2.0" />
		<PackageReference Include="libdave" Version="1.2.1.9" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="YoutubeExplode" Version="6.6.3" />
	</ItemGroup>

	<!-- Windows-only native libraries and FFmpeg -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">

		<None Update="nativeLibs\libsodium.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="nativeLibs\opus.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="nativeLibs\PATH_Programms\ffmpeg.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="nativeLibs\PATH_Programms\ffplay.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="nativeLibs\PATH_Programms\ffprobe.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

	<!-- Linux native libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">

		<None Update="nativeLibs/Linux/libopus.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>libopus.so</TargetPath>
		</None>

		<None Update="nativeLibs/Linux/libopus.so.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>libopus.so.0</TargetPath>
		</None>

		<None Update="nativeLibs/Linux/libopus.so.0.8.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>libopus.so.0.8.0</TargetPath>
		</None>

		<None Update="nativeLibs/Linux/libsodium.so.23">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>libsodium.so.23</TargetPath>
		</None>

		<None Update="nativeLibs/Linux/libsodium.so.23.3.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>libsodium.so.23.3.0</TargetPath>
		</None>

	</ItemGroup>

	<!-- Copy libdave.dll to the root of the Windows output -->
	<Target Name="CopyLibDaveToOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == 'win-x64'">

		<Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\libdave.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)runtimes\win-x64\native\libdave.dll')" />

	</Target>

</Project>
