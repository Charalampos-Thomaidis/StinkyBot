<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<LibDaveRuntimeLinking>true</LibDaveRuntimeLinking>
	</PropertyGroup>

	<PropertyGroup>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<StartupObject></StartupObject>
		<ApplicationIcon />
		<Win32Resource />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Commands" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Core" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Dave" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Interactions" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Rest" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Webhook" Version="3.20.2" />
		<PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
		<PackageReference Include="DotNetEnv" Version="3.2.0" />
		<PackageReference Include="libdave" Version="1.2.1.9" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="OpusSharp.Natives" Version="1.6.1.4" />
		<PackageReference Include="Sodium.Core" Version="1.4.1" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Private.Uri" Version="4.3.2" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
		<PackageReference Include="YoutubeExplode" Version="6.6.3" />
	</ItemGroup>
	
	<!-- Copy libdave, Opus and libsodium to the root of the output -->
	<Target Name="CopyLibDaveToOutput" AfterTargets="Build">

		<!-- Windows libdave -->
		<Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\libdave.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(TargetDir)runtimes\win-x64\native\libdave.dll')" />
		
		<!-- Windows Opus -->
		<Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\opus.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and Exists('$(TargetDir)runtimes\win-x64\native\opus.dll')" />
		
		<!-- Windows libsodium -->
		<Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\libsodium.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and Exists('$(TargetDir)runtimes\win-x64\native\libsodium.dll')" />
		
		<!-- Linux libdave -->
		<Copy SourceFiles="$(TargetDir)runtimes\linux-x64\native\libdave.so" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(TargetDir)runtimes\linux-x64\native\libdave.so')" />
		
		<!-- Linux Opus -->
		<Copy SourceFiles="$(NuGetPackageRoot)opussharp.natives\1.6.1.4\runtimes\linux-x64\native\opus.so" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
		
		<!-- Linux libsodium -->
		<Copy SourceFiles="$(NuGetPackageRoot)libsodium\1.0.22\runtimes\linux-x64\native\libsodium.so" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
		
	</Target>

</Project>